# ================================
# Monorepo Root .gitignore
# ================================

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Env files
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Secrets (CRITICAL - never commit)
secrets/
**/secrets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp
temp-json/

# NestJS build cache
**/tsconfig.build.tsbuildinfo

# Next.js (future)
.next/
out/
**/.next/
**/out/