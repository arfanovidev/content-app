# ================================
# Monorepo Root .gitignore
# ================================

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Env files
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Secrets (CRITICAL - never commit)
secrets/
**/secrets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp
temp-json/

# NestJS build cache
**/tsconfig.build.tsbuildinfo

# Next.js (future)
.next/
out/
**/.next/
**/out/
.env.production
.env.*.production
.env.local
.env.*.local

# Temporary scripts
api/cleanup-*.js
api/seed-*.js
api/shorten-*.js
api/quick-*.js
api/revert-*.js

# ========== Build cache ==========
*.tsbuildinfo
**/*.tsbuildinfo

# ========== One-off scripts ==========
web/patch-*.py
web/fix-*.py
web/shorten-*.js
web/cleanup-*.js
*.bak

# ========== ISD report (separate project) ==========
isd-report/

# ========== Build cache ==========
*.tsbuildinfo
**/*.tsbuildinfo

# ========== One-off scripts ==========
web/patch-*.py
web/fix-*.py
web/shorten-*.js
web/cleanup-*.js
*.bak

# ========== ISD report ==========
isd-report/

# Build cache
*.tsbuildinfo

# One-off scripts  
web/patch-*.py
web/fix-*.py
web/shorten-*.js
*.bak

# ISD report
isd-report/
